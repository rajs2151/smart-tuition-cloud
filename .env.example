# Copy to `.env` and fill in from Supabase → Project Settings → API.
# Never commit a real `.env` file.

SUPABASE_PROJECT_ID=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Vite client (same values; baked into the browser bundle at build time)
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Server-only — do NOT prefix with VITE_. Not required for the current app
# (no service-role code paths). Leave unset unless you add trusted server handlers.
# SUPABASE_SERVICE_ROLE_KEY=
